# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Jen na serveru – nikdy do prohlížeče
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Kdo se smí přihlásit (Google účty, oddělené čárkou)
ALLOWED_EMAILS=stanislav.kyska@gmail.com

# API pro agenty (ranní přehled, zadávání přes Clauda)
# Vygeneruj: openssl rand -hex 32
AGENT_API_TOKEN=
# Tvoje user id ze Supabase (Authentication → Users), po prvním přihlášení
OWNER_USER_ID=

# Google Kalendář (stejný OAuth klient jako pro přihlášení v Supabase)
# Google Cloud → Clients → tvůj klient → Client ID / Client secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
